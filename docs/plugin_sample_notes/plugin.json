{
  "$schema": "neri_plugin_v1",
  "id": "plugin_sample_notes",
  "name": "备忘便签与日常清单",
  "version": "1.0.0",
  "author": "Neri Dev",
  "description": "演示全栈微前端动态注入能力：向 WebUI 侧边栏动态注入「📝 备忘便签」独立页面，支持便签增删查改与持久化存储",
  "icon": "📝",
  "homepage": "https://github.com/neri-project/plugin_sample_notes",
  "min_bot_version": "1.0.0",
  "permissions": [
    "file_storage",
    "web_route"
  ],
  "dependencies": {
    "python": [],
    "plugins": []
  },
  "ui": {
    "has_tab": true,
    "tab_title": "📝 备忘便签",
    "tab_icon": "clipboard-list",
    "has_overview_card": true,
    "settings_schema": [
      {
        "key": "max_notes",
        "label": "最大便签保留数量",
        "type": "number",
        "default": 50,
        "description": "便签列表允许保存的最大条数"
      }
    ]
  }
}
